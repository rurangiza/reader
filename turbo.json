{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^db:generate"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/packages/typescript-config/*.json"
      ],
      "outputs": [
        "dist/**",
        "generated/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "PORT",
        "ALLOWED_ORIGINS"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint",
        "^build"
      ],
      "env": [
        "PORT",
        "ALLOWED_ORIGINS"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/typescript-config/*.json",
        "$TURBO_ROOT$/packages/eslint-config/**"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "^lint:fix",
        "^build"
      ],
      "env": [
        "PORT",
        "ALLOWED_ORIGINS"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/typescript-config/*.json",
        "$TURBO_ROOT$/packages/eslint-config/**"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/typescript-config/*.json"
      ]
    },
    "dev": {
      "dependsOn": [
        "^db:generate"
      ],
      "cache": false,
      "persistent": true,
      "env": [
        "PORT",
        "ALLOWED_ORIGINS"
      ]
    },
    "test:api": {
      "dependsOn": [
        "^test:api",
        "^build",
        "^db:generate"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "env": [
        "PORT",
        "ALLOWED_ORIGINS"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    }
  }
}
